<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Test Suite">

    <parameter name="browser" value="chrome"/>

    <test name="Smoke Tests">

        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>

        <packages>
            <package name="tests"/>
        </packages>

    </test>

</suite>